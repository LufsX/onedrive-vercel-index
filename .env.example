# Copy to .env for Docker Compose. Uncomment and set the variables you need.
# The configured Microsoft account must match userPrincipalName returned by Microsoft Graph.
# NEXT_PUBLIC_USER_PRINCIPLE_NAME=account@example.com
# Generate or replace these values at /onedrive-vercel-index-oauth/step-0?generate=1, then restart/redeploy.
# In Vercel, enter each value only (without the variable name or surrounding quotes).
# Leave ADMIN_PASSWORD_HASH unset for read-only OAuth; administrator functions stay disabled.
# ADMIN_PASSWORD_HASH=scrypt:16384:8:1:<salt>:<hash>
# ADMIN_SESSION_SECRET=
# Required for tokens, administrator sessions and rate limits. Compose sets its own internal Redis URL.
# REDIS_URL=redis://localhost:6379
# UPLOAD_MAX_BYTES=
# OAUTH_CLIENT_SECRET=
# KV_PREFIX=
# APP_PORT=3000

# Site configuration. Values other than KV_PREFIX are visible to site visitors.
# NEXT_PUBLIC_SITE_TITLE=My OneDrive
# NEXT_PUBLIC_ICON=/icons/128.png
# NEXT_PUBLIC_BASE_DIRECTORY=/Share
# NEXT_PUBLIC_MAX_ITEMS=100
# NEXT_PUBLIC_GOOGLE_FONT_SANS=Inter
# NEXT_PUBLIC_GOOGLE_FONT_MONO=Fira Mono
# NEXT_PUBLIC_GOOGLE_FONT_LINKS='["https://fonts.googleapis.com/css2?family=Fira+Mono&family=Inter:wght@400;500;700&display=swap"]'
# NEXT_PUBLIC_FOOTER=
# NEXT_PUBLIC_PROTECTED_ROUTES='["/private"]'
# NEXT_PUBLIC_EMAIL=mailto:account@example.com
# NEXT_PUBLIC_LINKS='[{"name":"Telegram","link":"https://t.me/example"}]'
# NEXT_PUBLIC_DATETIME_FORMAT=YYYY-MM-DD HH:mm:ss

# Optional third-party content, given as JSON arrays. Both lists are empty by default,
# so an unconfigured deployment loads no third-party code.
# Links are hoisted into <head>, in order:
#   {"rel":"dns-prefetch"|"preconnect"|"prefetch"|"preload","href":"https://...","crossOrigin":true|"anonymous"|"use-credentials"}
# NEXT_PUBLIC_THIRD_PARTY_LINKS='[{"rel":"dns-prefetch","href":"https://www.googletagmanager.com"},{"rel":"preconnect","href":"https://client.crisp.chat","crossOrigin":true}]'
# Scripts load in order and need exactly one of src or content:
#   {"id":"unique-id","src":"https://...","content":"inline JavaScript","strategy":"beforeInteractive"|"afterInteractive"|"lazyOnload"}
# The strategy defaults to lazyOnload. Inline JavaScript is JSON-escaped: use \" for quotes and \n for new lines.
# Next.js expands $VAR references in every value, so write a literal dollar sign as \$ (for example window.\$crisp).
# NEXT_PUBLIC_THIRD_PARTY_SCRIPTS='[{"id":"ga","src":"https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"},{"id":"ga-init","content":"window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)};gtag(\"js\",new Date());gtag(\"config\",\"G-XXXXXXXXXX\")"}]'
# Vercel Web Analytics, only useful on deployments hosted on Vercel.
# NEXT_PUBLIC_VERCEL_ANALYTICS=true

# OneDrive API configuration.
# NEXT_PUBLIC_CLIENT_ID=6280202a-1acd-47d6-b311-7a6367163699
# NEXT_PUBLIC_REDIRECT_URI=http://localhost
# NEXT_PUBLIC_AUTH_API=https://login.microsoftonline.com/common/oauth2/v2.0/token
# NEXT_PUBLIC_DRIVE_API=https://graph.microsoft.com/v1.0/me/drive
# NEXT_PUBLIC_SCOPE=user.read files.readwrite offline_access
# NEXT_PUBLIC_CACHE_CONTROL_HEADER=max-age=0, s-maxage=600, stale-while-revalidate
