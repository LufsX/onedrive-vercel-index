# Copy to .env for Docker Compose. Uncomment and set the variables you need.
# The configured Microsoft account must match userPrincipalName returned by Microsoft Graph.
# NEXT_PUBLIC_USER_PRINCIPLE_NAME=account@example.com
# OAUTH_SETUP_SECRET=replace-with-a-strong-random-secret
# OAUTH_CLIENT_SECRET=
# KV_PREFIX=
# APP_PORT=3000

# Site configuration. Values other than KV_PREFIX are visible to site visitors.
# NEXT_PUBLIC_SITE_TITLE=My OneDrive
# NEXT_PUBLIC_ICON=/icons/128.png
# NEXT_PUBLIC_BASE_DIRECTORY=/Share
# NEXT_PUBLIC_MAX_ITEMS=100
# NEXT_PUBLIC_GOOGLE_FONT_SANS=Inter
# NEXT_PUBLIC_GOOGLE_FONT_MONO=Fira Mono
# NEXT_PUBLIC_GOOGLE_FONT_LINKS='["https://fonts.googleapis.com/css2?family=Fira+Mono&family=Inter:wght@400;500;700&display=swap"]'
# NEXT_PUBLIC_FOOTER=
# NEXT_PUBLIC_PROTECTED_ROUTES='["/private"]'
# NEXT_PUBLIC_EMAIL=mailto:account@example.com
# NEXT_PUBLIC_LINKS='[{"name":"Telegram","link":"https://t.me/example"}]'
# NEXT_PUBLIC_DATETIME_FORMAT=YYYY-MM-DD HH:mm:ss

# OneDrive API configuration.
# NEXT_PUBLIC_CLIENT_ID=6280202a-1acd-47d6-b311-7a6367163699
# NEXT_PUBLIC_REDIRECT_URI=http://localhost
# NEXT_PUBLIC_AUTH_API=https://login.microsoftonline.com/common/oauth2/v2.0/token
# NEXT_PUBLIC_DRIVE_API=https://graph.microsoft.com/v1.0/me/drive
# NEXT_PUBLIC_SCOPE=user.read files.read.all offline_access
# NEXT_PUBLIC_CACHE_CONTROL_HEADER=max-age=0, s-maxage=600, stale-while-revalidate
